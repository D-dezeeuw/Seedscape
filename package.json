{
  "name": "seedscape",
  "version": "0.0.0",
  "private": true,
  "description": "Videogame: Cosy infinite farm simulator for web",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ vite.config.ts",
    "format": "biome format --write src/ vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D-dezeeuw/Seedscape.git"
  },
