  "bugs": {
    "url": "https://github.com/D-dezeeuw/Seedscape/issues"
  },
  "homepage": "https://github.com/D-dezeeuw/Seedscape#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
